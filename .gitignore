# Rust
/target/
**/*.rs.bk
Cargo.lock.orig

# Benchmarks: results are published per release, not committed per run.
/bench/results/

# mdBook output is under /target/book/ (book.toml), covered by /target/ above

# Editors and OS
.idea/
.vscode/
.DS_Store

# Claude Code local-only files
CLAUDE.*.md
.claude/settings.local.json

# other
.ignored/
.brigade
__pycache__/

# The Node client's addon and npm's files, built by `npm install` in clients/node
# (clients/node/README.md); the generated sources beside them are committed.
/clients/node/build/
/clients/node/node_modules/
/clients/node/package-lock.json

# The JVM client's classes, compiled by `javac` as clients/jvm/README.md says, and the
# runner's (conformance/jvm/run.sh); the generated sources beside them are committed.
/clients/jvm/build/
/conformance/jvm/build/
# The .NET client's, its example's and its runners' build output, written by
# `dotnet build` (clients/dotnet/README.md); the generated sources are committed.
/clients/dotnet/bin/
/clients/dotnet/obj/
/clients/dotnet/example/bin/
/clients/dotnet/example/obj/
/conformance/dotnet/*/bin/
/conformance/dotnet/*/obj/
